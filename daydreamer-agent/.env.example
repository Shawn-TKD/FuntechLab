# 本文件不包含真实密钥。可复制为 .env 并填写，或设置环境变量。
# 也可通过 --credentials-csv 在内存中读取已有密钥文件；不要提交 .env。
DASHSCOPE_API_KEY=
# 填写 CSV 中 openAiCompatible 的值，不含结尾 /chat/completions。
DASHSCOPE_OPENAI_BASE_URL=
# 填写 CSV 中 dashScope 的值，不含具体服务路径。
DASHSCOPE_API_BASE_URL=
# 后续确定音乐、音效服务后补充相应配置。
# 可选：覆盖媒体工具路径。
# FFMPEG_PATH=
# FFPROBE_PATH=
